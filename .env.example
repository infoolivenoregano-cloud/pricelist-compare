# Copy this to .env for local development (never commit .env)

# Local Docker Compose default — leave as-is for local dev
DATABASE_URL=postgresql://pricelist:pricelist123@localhost:5432/pricelist

# Production: paste your Supabase connection string here
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# CORS: comma-separated list of allowed frontend origins
# Leave blank (or *) for local dev; set to your Vercel URL in production
ALLOWED_ORIGINS=*
# ALLOWED_ORIGINS=https://your-app.vercel.app
